DB_NAME=postgres
DB_SCHEMA=verifier
DB_USER=postgres
DB_PASSWORD=this-is-not-secure
DB_HOST=localhost
DB_PORT=5432
DB_NETWORK_NAME=network-where-postgres-is-running
PORT=5000
LISTEN_ADDRESS=0.0.0.0
BASEURL=http://localhost

# Token for the generic administrative API (/admin/*).
# Leave EMPTY to keep the file-based conf/ configuration authoritative:
# on startup the verifiers and presentations tables are cleared and
# reloaded from conf/. Set it to enable the admin API and DB-backed config.
BEARER_TOKEN=

# Passphrase used to encrypt private keys at rest in the database.
# Empty means private keys are stored unencrypted. Changing it after keys
# have been written makes existing keys undecryptable.
PASSPHRASE=

# OpenID Federation. OIDFED_KEY must be a dedicated alias from conf/dids
# and must not be reused for anything else.
OIDFED_KEY=oidfed
OIDFED_ADMIN_CONTACT=
OIDFED_AUTH=
OIDFED_TA=

TRAEFIK_ENTRYPOINT=web
HOST=localhost
